{
  "name": "ai-task-assistant",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend/shared",
    "backend/services/*"
  ],
  "scripts": {
    "start:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up --build --watch",
    "test": "vitest",
    "test:prompts": "npm run test:prompts -w backend/services/ai",
    "test:db": "npm run test:db -w backend/services/tasks",
    "type-check": "npm run type-check:watch -w backend/shared & npm run type-check:watch -w backend/services/ai & npm run type-check:watch -w backend/services/tasks & wait",
    "type-check:ci": "npm run type-check -w backend/shared && npm run type-check -w backend/services/ai && npm run type-check -w backend/services/tasks"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "zod": "^3.23.8"
  }
}
